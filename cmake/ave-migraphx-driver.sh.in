#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="$(cd -- "${script_dir}/@AVE_PREFIX_REL_FROM_MIGRAPHX_BINDIR@" && pwd)"

resolve_path() {
    local value="$1"
    if [[ "${value}" = /* ]]; then
        printf '%s\n' "${value}"
    else
        printf '%s\n' "${prefix}/${value}"
    fi
}

bundled_migraphx="$(resolve_path "@AVE_INSTALL_MIGRAPHX_PATH@")"
bundled_runtime="$(resolve_path "@AVE_INSTALL_RUNTIME_PATH@")"
tool_bin="${bundled_migraphx}/bin"
tool_driver="${tool_bin}/migraphx-driver"
tool_lib="${bundled_migraphx}/lib"
tool_nested_lib="${bundled_migraphx}/lib/migraphx/lib"

prepend_path() {
    local var_name="$1"
    local entry="$2"
    if [[ ! -e "${entry}" ]]; then
        return
    fi
    local current="${!var_name:-}"
    if [[ -n "${current}" ]]; then
        export "${var_name}=${entry}:${current}"
    else
        export "${var_name}=${entry}"
    fi
}

if [[ ! -x "${tool_driver}" ]]; then
    echo "Bundled migraphx-driver not found at ${tool_driver}" >&2
    exit 127
fi

prepend_path PATH "${tool_bin}"
prepend_path LD_LIBRARY_PATH "${bundled_runtime}"
prepend_path LD_LIBRARY_PATH "${tool_lib}"
prepend_path LD_LIBRARY_PATH "${tool_nested_lib}"

export AVE_BUNDLED_MIGRAPHX_PREFIX="${bundled_migraphx}"

exec "${tool_driver}" "$@"
