#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="$(cd -- "${script_dir}/@AVE_PREFIX_REL_FROM_BINDIR@" && pwd)"

resolve_path() {
    local value="$1"
    if [[ "${value}" = /* ]]; then
        printf '%s\n' "${value}"
    else
        printf '%s\n' "${prefix}/${value}"
    fi
}

app_bin="$(resolve_path "@AVE_INSTALL_APP_BINARY_PATH@")"
bundled_migraphx="$(resolve_path "@AVE_INSTALL_MIGRAPHX_PATH@")"
bundled_runtime="$(resolve_path "@AVE_INSTALL_RUNTIME_PATH@")"
bundled_qt_plugins="$(resolve_path "@AVE_INSTALL_QT_PLUGIN_PATH@")"
bundled_models="$(resolve_path "@AVE_INSTALL_MODELS_PATH@")"
bundled_migraphx_lib="${bundled_migraphx}/lib"
bundled_migraphx_nested_lib="${bundled_migraphx}/lib/migraphx/lib"

prepend_path() {
    local var_name="$1"
    local entry="$2"
    if [[ ! -e "${entry}" ]]; then
        return
    fi
    local current="${!var_name:-}"
    if [[ -n "${current}" ]]; then
        export "${var_name}=${entry}:${current}"
    else
        export "${var_name}=${entry}"
    fi
}

if [[ -d "${bundled_runtime}" ]]; then
    prepend_path LD_LIBRARY_PATH "${bundled_runtime}"
fi

if [[ -d "${bundled_migraphx}" ]]; then
    prepend_path LD_LIBRARY_PATH "${bundled_migraphx_lib}"
    prepend_path LD_LIBRARY_PATH "${bundled_migraphx_nested_lib}"
    export AVE_BUNDLED_MIGRAPHX_PREFIX="${bundled_migraphx}"
fi

if [[ -d "${bundled_qt_plugins}" ]]; then
    prepend_path QT_PLUGIN_PATH "${bundled_qt_plugins}"
    if [[ -d "${bundled_qt_plugins}/platforms" ]]; then
        export QT_QPA_PLATFORM_PLUGIN_PATH="${bundled_qt_plugins}/platforms"
    fi
fi

if [[ -d "${bundled_models}" ]]; then
    export AVE_BUNDLED_MODELS_DIR="${bundled_models}"
fi

export AVE_APP_INSTALL_PREFIX="${prefix}"

exec "${app_bin}" "$@"
